            "UM1": 8,
            "UM2": 8,
            "U1": 3,
            "UP": 15,
            "UX": 0,
            "U3": 10
          },
          "descripcion": "Número máximo de personas que puede transportar",
          "mutable": false,
          "restricciones": [
            "El conductor no cuenta para la capacidad",
            "Es una característica fija de cada unidad"
          ],
          "implementacion_pddl": "Predicado (puede_transportar_personas ?u ?n)"
        },
        {
          "nombre": "espacioDisponible",
          "tipo": "Integer",
          "rango": [0, "capacidadPersonas"],
          "valor_por_defecto": "Igual a capacidadPersonas",
          "descripcion": "Número actual de espacios libres",
          "mutable": true,
          "restricciones": [
            "Disminuye al cargar personas",
            "Aumenta al descargar personas",
            "No puede ser negativo ni exceder capacidadPersonas"
          ],
          "implementacion_pddl": "Predicado (capacidad_disponible ?u ?n)"
        },
        {
          "nombre": "puedeTransportarCarga",
