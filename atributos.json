          "valores_posibles": [true, false],
          "valor_por_defecto": "Específico por instancia",
          "valores_por_instancia": {
            "UM1": false,
            "UM2": false,
            "U1": true,
            "UP": true,
            "UX": true,
            "U3": false
          },
          "descripcion": "Indica si puede transportar recursos pesados",
          "mutable": false,
          "restricciones": [
            "Solo U1, UP y UX pueden cargar recursos",
            "Es característica fija del diseño del vehículo"
