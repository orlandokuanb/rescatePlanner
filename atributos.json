  "atributos_por_concepto": [
    {
      "concepto": "Victima",
      "atributos": [
        {
          "nombre": "estadoSalud",
          "tipo": "Enumerado",
          "valores_posibles": ["Grave", "Estable", "NoAfectado", "Estabilizado"],
          "valor_por_defecto": "Depende del subtipo",
          "descripcion": "Condición médica actual de la víctima",
          "mutable": true,
          "restricciones": [
            "Grave solo puede cambiar a Estabilizado",
            "Estable y NoAfectado no cambian de estado",
            "Solo el médico puede cambiar Grave a Estabilizado"
          ],
          "implementacion_pddl": "Tipo + predicado estabilizado"
        },
        {
          "nombre": "necesitaEstabilizacion",
          "tipo": "Boolean",
          "valores_posibles": [true, false],
          "valor_por_defecto": "true para VictimaGrave, false para otras",
          "descripcion": "Indica si requiere atención médica urgente",
          "mutable": false,
          "restricciones": [
            "Determinado por el tipo de víctima",
            "No cambia durante la simulación"
          ],
          "implementacion_pddl": "Implícito en el tipo victima_grave"
        },
        {
          "nombre": "ubicacionActual",
          "tipo": "Locacion",
          "valores_posibles": ["C0", "C1", "C2", "C3", "M"],
          "valor_por_defecto": "M (todas comienzan en la mina)",
          "descripcion": "Posición física actual de la víctima",
          "mutable": true,
          "restricciones": [
            "Cambia cuando es transportada en unidad móvil",
            "Meta: todas deben terminar en C0"
          ],
          "implementacion_pddl": "Predicado (en ?victima ?locacion)"
        },
        {
          "nombre": "rescatado",
          "tipo": "Boolean",
          "valores_posibles": [true, false],
          "valor_por_defecto": false,
          "descripcion": "Marca si la víctima llegó exitosamente a C0",
          "mutable": true,
          "restricciones": [
            "Solo puede cambiar de false a true",
            "Es condición de meta del problema"
          ],
          "implementacion_pddl": "Predicado (rescatado ?victima)"
        }
      ]
    },
    {
      "concepto": "UnidadMovil",
      "atributos": [
        {
