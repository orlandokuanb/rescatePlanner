        {
          "nombre": "ubicacionActual",
          "tipo": "Locacion",
          "valores_posibles": ["C0", "C1", "C2", "C3", "M"],
          "valor_por_defecto": "C0 (todas comienzan en base)",
          "descripcion": "Posición física actual del vehículo",
          "mutable": true,
          "restricciones": [
