          "valores_posibles": ["UM", "U1", "UP", "UX", "U3"],
          "valor_por_defecto": "Específico por instancia",
          "descripcion": "Clasificación del vehículo según su función",
          "mutable": false,
          "restricciones": [
            "Determina capacidad y tipo de carga",
            "Es característica inherente"
          ],
          "implementacion_pddl": "Tipos en PDDL"
        }
      ]
    },
    {
